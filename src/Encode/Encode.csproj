<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>encode</AssemblyName>
    <RootNamespace>Shield.Cli</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <!-- CS0162: the encode/decode mode switch is a compile time constant on purpose. -->
    <NoWarn>$(NoWarn);CS0162</NoWarn>
    <Version>1.0.0</Version>
    <Product>Win WebApp Shield - encode</Product>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Cli\CliProgram.cs" Link="CliProgram.cs" />
    <ProjectReference Include="..\Shield.Crypto\Shield.Crypto.csproj" />
  </ItemGroup>
</Project>
